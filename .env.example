PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/patient_health_records
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1h

FILE_ENCRYPTION_KEY=replace_with_64_hex_characters
WALLET_ENCRYPTION_KEY=replace_with_a_long_random_string

GANACHE_RPC_URL=http://127.0.0.1:8545
DEPLOYER_PRIVATE_KEY=replace_with_a_ganache_test_private_key

MAX_UPLOAD_MB=5
